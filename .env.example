# ==============================================================================
# UAV Lab - Production Environment Variables Template
# ==============================================================================
# Copy this file to .env on the deployment server:
#   cp .env.example .env
#
# Generate a strong password with:
#   openssl rand -hex 16
# ==============================================================================

# Database Settings
POSTGRES_DB=uav_telemetry
POSTGRES_USER=uav_admin
POSTGRES_PASSWORD=change_this_to_a_secure_password_in_production

# Public Ingress Domain (managed by Caddy Docker Proxy)
UAV_DOMAIN=uav.example.com
