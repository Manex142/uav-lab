# ==============================================================================
# UAV Lab - Edge Deployment Configuration (Raspberry Pi 5)
# ==============================================================================

# Telemetry ingestion server destination (Hetzner VPS WireGuard IP:port)
GATEWAY_TARGET=10.0.0.1:9876

# Number of concurrent simulated UAV swarm agents
DRONE_COUNT=3

# Telemetry emission rate per drone (Hz)
TELEMETRY_RATE=10

# Watchtower OTA poll interval in seconds (default: 300s = 5 minutes)
WATCHTOWER_POLL_INTERVAL=300
